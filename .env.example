# Copiez ce fichier en .env et remplissez les valeurs. Ne commitez jamais .env.

# Base de donnees (Supabase) : soit DATABASE_URL, soit les variables DB_*
DATABASE_URL=postgresql://user:password@host:5432/postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=portfolio
# DB_USER=postgres
# DB_PASSWORD=

# Obligatoire, 32 caracteres minimum : le serveur refuse de demarrer sans.
# Generer : openssl rand -hex 32
JWT_SECRET=

# Utilises par `npm run db:init` et `npm run admin:password` (12 caracteres minimum).
# Retirez ADMIN_PASSWORD une fois le compte cree.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# URL du frontend autorisee par CORS
FRONTEND_URL=http://localhost:5173

# Envoi des notifications de contact (mot de passe d'application Gmail)
EMAIL_USER=
EMAIL_PASS=

# Upload des images
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
